# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Session Configuration
SESSION_SECRET=dev-insecure-session-secret-change-in-production-min-32-chars
SESSION_MAX_AGE_MS=86400000

# PostgreSQL Database Configuration
# Format: postgresql://[user[:password]@][netloc][:port][/dbname][?param1=value1&...]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/university_event_db

# Granular Database Connection Parameters (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=university_event_db
DB_SSL=false
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
